# Munshi — Development Environment
# NEVER commit real credentials. This file uses placeholder values.
# Copy to .env.dev.local and fill in real values for local dev.

SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your-dev-anon-key

APP_ENV=development
APP_NAME=Munshi Dev
APP_FLAVOR=dev

# Feature flags (dev: all on)
FEATURE_WHATSAPP=true
FEATURE_DEMAND_MATCHING=true
FEATURE_DEALER_CIRCLES=false
FEATURE_DOCUMENTS=true
FEATURE_WEB_CONSOLE=false
FEATURE_BILLING=false
